# Fills a store from the registry: every triplet of every layer, or the triplets given. The bundle's CI fills its
# store so; locally a debugging aid.
#
#   cmake -DSTORE=build/store -DREGISTRY=ghcr.io/opendaq/dev/staging \
#         -DLAYERS="opendaq=<sha>;opcua-modules=<sha>;…" [-DTRIPLETS="<triplet>;…"] \
#         [-DORAS_REGISTRY_CONFIG=~/.oras/config.json] -P tools/fill-store.cmake
#
# For each layer: the newest index whose revision is the one given; for each package in it, the identity
# from its annotations, the place from cmake/FetchLayer/identity.cmake, the tarball into
# <store>/.downloads/sha256-<digest>.tar.gz, unpacked beside the place and renamed into it (opt/opendaq taken
# off), so a place is whole once it exists. A place already there is kept.

cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/FetchLayer/identity.cmake")

set(FETCHLAYER_IDENTITY_REVISION_KEY   "org.opencontainers.image.revision")
set(FETCHLAYER_IDENTITY_DEPENDENCY_KEY "com.opendaq.dependencies.<name>.revision")
set(FETCHLAYER_IDENTITY_AXIS_KEY       "com.opendaq.package.<axis>")

foreach(_var STORE REGISTRY LAYERS)
    if (NOT ${_var})
        message(FATAL_ERROR "fill-store: -D${_var}= is required")
    endif()
endforeach()
get_filename_component(STORE "${STORE}" ABSOLUTE)
set(FETCHLAYER_STORE "${STORE}")

find_program(ORAS oras REQUIRED)
set(_config)
if (ORAS_REGISTRY_CONFIG)
    set(_config --registry-config "${ORAS_REGISTRY_CONFIG}")
endif()

function(oras OUT)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "OPTIONAL" "" "")
    execute_process(COMMAND "${ORAS}" ${ARG_UNPARSED_ARGUMENTS} ${_config}
                    OUTPUT_VARIABLE _out ERROR_VARIABLE _err RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE)
    if (NOT _rc EQUAL 0)
        if (NOT ARG_OPTIONAL)
            list(JOIN ARG_UNPARSED_ARGUMENTS " " _args)
            message(FATAL_ERROR "oras ${_args}:\n${_err}")
        endif()
        set(_out "")
    endif()
    set(${OUT} "${_out}" PARENT_SCOPE)
endfunction()

# the newest index of <repo> whose revision is <revision>
function(find_index OUT REPO REVISION)
    oras(_tags repo tags "${REPO}")
    string(REGEX REPLACE "[\r\n]+" ";" _tags "${_tags}")
    set(_best "")
    set(_best_created "")
    set(_seen)
    foreach(_tag IN LISTS _tags)
        if (NOT _tag OR _tag MATCHES "^pkg-")
            continue()
        endif()
        oras(_index manifest fetch "${REPO}:${_tag}" OPTIONAL)
        string(SHA256 _h "${_index}")
        if (NOT _index OR _h IN_LIST _seen)
            continue()
        endif()
        list(APPEND _seen ${_h})
        string(JSON _rev ERROR_VARIABLE _e GET "${_index}" annotations "org.opencontainers.image.revision")
        if (NOT _rev STREQUAL REVISION)
            continue()
        endif()
        string(JSON _created ERROR_VARIABLE _e GET "${_index}" annotations "org.opencontainers.image.created")
        if (NOT _best OR _created STRGREATER _best_created)
            set(_best "${_index}")
            set(_best_created "${_created}")
        endif()
    endforeach()
    if (NOT _best)
        message(FATAL_ERROR "fill-store: no index of ${REPO} has revision ${REVISION}")
    endif()
    set(${OUT} "${_best}" PARENT_SCOPE)
endfunction()

# the dependency pairs <dep>=<sha> in an annotations object
function(dependencies OUT ANNOTATIONS)
    set(_pairs)
    string(JSON _n LENGTH "${ANNOTATIONS}")
    math(EXPR _last "${_n} - 1")
    foreach(_i RANGE ${_last})
        string(JSON _key MEMBER "${ANNOTATIONS}" ${_i})
        if (_key MATCHES "^com\\.opendaq\\.dependencies\\.(.+)\\.revision$")
            set(_dep "${CMAKE_MATCH_1}")
            string(JSON _sha GET "${ANNOTATIONS}" "${_key}")
            list(APPEND _pairs "${_dep}=${_sha}")
        endif()
    endforeach()
    list(SORT _pairs)
    set(${OUT} "${_pairs}" PARENT_SCOPE)
endfunction()

set(_total 0)
set(_kept 0)
foreach(_entry IN LISTS LAYERS)
    string(REGEX MATCH "^([^=]+)=(.+)$" _ "${_entry}")
    set(_layer "${CMAKE_MATCH_1}")
    set(_revision "${CMAKE_MATCH_2}")
    set(_repo "${REGISTRY}/${_layer}")
    message(STATUS "${_layer}@${_revision}")

    find_index(_index "${_repo}" "${_revision}")
    string(JSON _index_ann ERROR_VARIABLE _e GET "${_index}" annotations)
    string(JSON _count LENGTH "${_index}" manifests)
    math(EXPR _last "${_count} - 1")
    foreach(_i RANGE ${_last})
        string(JSON _digest GET "${_index}" manifests ${_i} digest)
        string(JSON _ann GET "${_index}" manifests ${_i} annotations)
        string(JSON _triplet GET "${_ann}" "com.opendaq.package.triplet")
        string(JSON _title GET "${_ann}" "org.opencontainers.image.title")
        if (TRIPLETS AND NOT _triplet IN_LIST TRIPLETS)
            continue()
        endif()

        # the build's identity: the package's annotations, the index's where it has none
        set(b_NAME "${_layer}")
        string(JSON b_REVISION ERROR_VARIABLE _e GET "${_ann}" "org.opencontainers.image.revision")
        if (_e)
            string(JSON b_REVISION GET "${_index_ann}" "org.opencontainers.image.revision")
        endif()
        dependencies(b_DEPENDS_REVISIONS "${_ann}")
        if (NOT b_DEPENDS_REVISIONS)
            dependencies(b_DEPENDS_REVISIONS "${_index_ann}")
        endif()
        __FetchLayer_variant_format(b_VARIANT "triplet=${_triplet}")
        __FetchLayer_identity_path(b _place)
        math(EXPR _total "${_total} + 1")

        if (IS_DIRECTORY "${_place}")
            message(STATUS "  ${_triplet}: kept")
            math(EXPR _kept "${_kept} + 1")
            continue()
        endif()

        # download once per digest
        string(REPLACE ":" "-" _file "${_digest}")
        set(_archive "${STORE}/.downloads/${_file}.tar.gz")
        if (NOT EXISTS "${_archive}")
            set(_tmp "${STORE}/.downloads/.tmp")
            file(REMOVE_RECURSE "${_tmp}")
            oras(_ pull "${_repo}@${_digest}" -o "${_tmp}")
            file(RENAME "${_tmp}/${_title}" "${_archive}")
            file(REMOVE_RECURSE "${_tmp}")
        endif()

        # unpack; a prefix carried inside the tarball (opt/opendaq) is taken off
        set(_unpack "${_place}.tmp")
        file(REMOVE_RECURSE "${_unpack}" "${_place}")
        file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${_unpack}")
        if (IS_DIRECTORY "${_unpack}/opt/opendaq")
            file(RENAME "${_unpack}/opt/opendaq" "${_place}")
            file(REMOVE_RECURSE "${_unpack}")
        else()
            file(RENAME "${_unpack}" "${_place}")
        endif()

        message(STATUS "  ${_triplet}: ${_digest}")
    endforeach()
endforeach()
message(STATUS "fill-store: ${_total} builds, ${_kept} kept, into ${STORE}")
