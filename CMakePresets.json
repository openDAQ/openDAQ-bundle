{
    "version": 6,
    "configurePresets": [
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "binaryDir": "build/${presetName}"
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "binaryDir": "build/${presetName}"
        },
        {
            "name": "gcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "ninja",
            "hidden": true,
            "generator": "Ninja"
        },
        {
            "name": "msvc-17",
            "hidden": true,
            "generator": "Visual Studio 15 2017",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [ "Windows" ]
                }
            }
        },
        {
            "name": "msvc-22",
            "hidden": true,
            "generator": "Visual Studio 17 2022",
            "inherits": [
                "msvc-17"
            ]
        },
        {
            "name": "msvc-x86",
            "hidden": true,
            "architecture": "Win32",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [ "Windows" ]
                }
            }
        },
        {
            "name": "msvc-x64",
            "hidden": true,
            "architecture": "x64",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [ "Windows" ]
                }
            }
        },
        {
            "name": "x86/msvc-17",
            "displayName": "[MSVC 17] Release - x86",
            "inherits": [
                "release",
                "msvc-17",
                "msvc-x86"
            ]
        },
        {
            "name": "revisions",
            "hidden": true,
            "description": "The bundle: one commit per layer",
            "cacheVariables": {
                "BUNDLE_REVISION_OPENDAQ": "1a82fa899b78e23ddcf61975eb9255b22e713808",
                "BUNDLE_REVISION_OPCUAMODULES": "485710c37d06bcc6b6c852e57fd27c0b2cce7d08",
                "BUNDLE_REVISION_MQTTSTREAMINGMODULE": "3a55f4bf710ca10513ed64464e74680246e35e9f",
                "BUNDLE_REVISION_LTSTREAMINGMODULESMODERN": "322d770b08e033eb6033d417c2310fdb832e088a",
                "BUNDLE_REVISION_ASAM-CMP-MODULES": "a95b8cea31cca2c5e437c7e55d38bc9efc7703a6"
            }
        },
        {
            "name": "bundle-prefixes",
            "displayName": "Bundle from stagings given as prefixes (FETCHLAYER_PREFIX_<STAGING>), nothing compiled; CI",
            "inherits": [
                "release",
                "revisions"
            ],
            "cacheVariables": {
                "BUNDLE_STAGINGS": "opendaq;opcua-modules;mqtt-module;lt-streaming-modules;asam-cmp-modules",
                "FETCHLAYER_BUILD": "NEVER"
            }
        },
        {
            "name": "bundle-native",
            "displayName": "Bundle by FetchLayer, this machine's triplet",
            "inherits": [
                "release",
                "ninja",
                "revisions"
            ],
            "cacheVariables": {
                "BUNDLE_STAGINGS": "opendaq;opcua-modules;mqtt-module;lt-streaming-modules;asam-cmp-modules",
                "FETCHLAYER_STORE": "${sourceDir}/build/store"
            }
        },
        {
            "name": "x64/msvc-17",
            "displayName": "[MSVC 17] Release - x64",
            "inherits": [
                "release",
                "msvc-17",
                "msvc-x64"
            ]
        },
        {
            "name": "x86/msvc-22",
            "displayName": "[MSVC 22] Release - x86",
            "inherits": [
                "release",
                "msvc-22",
                "msvc-x86"
            ]
        },
        {
            "name": "x64/msvc-22",
            "displayName": "[MSVC 22] Release - x64",
            "inherits": [
                "release",
                "msvc-22",
                "msvc-x64"
            ]
        },
        {
            "name": "x64/gcc/debug",
            "displayName": "[GCC] Debug - x64",
            "inherits": [
                "debug",
                "gcc",
                "ninja"
            ]
        },
        {
            "name": "x64/gcc/release",
            "displayName": "[GCC] Release - x64",
            "inherits": [
                "release",
                "gcc",
                "ninja"
            ]
        },
        {
            "name": "x64/clang/debug",
            "displayName": "[Clang] Debug - x64",
            "inherits": [
                "debug",
                "clang",
                "ninja"
            ]
        },
        {
            "name": "x64/clang/release",
            "displayName": "[Clang] Release - x64",
            "inherits": [
                "release",
                "clang",
                "ninja"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "bundle-native",
            "configurePreset": "bundle-native"
        }
    ],
    "packagePresets": [
        {
            "name": "core",
            "displayName": "The core: runtime, C++ API, C",
            "configurePreset": "bundle-native",
            "generators": [
                "TGZ"
            ],
            "variables": {
                "BUNDLE_PACK_STAGINGS": "opendaq",
                "BUNDLE_PACK_COMPONENTS": "Runtime;Development",
                "CPACK_OPENDAQ_META_PACKAGE_NAME": "opendaq-core"
            }
        },
        {
            "name": "installer",
            "displayName": "The core with the modules, the modules optional where the generator offers choices (-G DEB, NSIS, productbuild)",
            "configurePreset": "bundle-native",
            "variables": {
                "BUNDLE_PACK_STAGINGS": "opendaq;opcua-modules;mqtt-module;lt-streaming-modules;asam-cmp-modules",
                "BUNDLE_PACK_COMPONENTS": "Runtime;Development",
                "CPACK_OPENDAQ_META_PACKAGE_NAME": "opendaq-bundle"
            }
        },
        {
            "name": "modules",
            "displayName": "The modules, without the core",
            "configurePreset": "bundle-native",
            "generators": [
                "TGZ"
            ],
            "variables": {
                "BUNDLE_PACK_STAGINGS": "opcua-modules;mqtt-module;lt-streaming-modules;asam-cmp-modules",
                "BUNDLE_PACK_COMPONENTS": "Runtime",
                "CPACK_OPENDAQ_META_PACKAGE_NAME": "opendaq-modules"
            }
        }
    ]
}
