##
## Variants: a variant of a staging is one value of each of its axes — what it is built for, as against what it
## is built from. Its identity, pkg-, is the staging's at a revision, idx- (what it is built from), together with
## these values.
##
## A variant is written as one string: the triplet, then +<axis>=<value> for each other axis by name —
## x86_64-macos-apple-clang-21-release+python=3.12; without a triplet the pairs alone, python=3.12; without any
## axis, any. The same values give the same string, whatever their order. It names the Instance and the
## variant's directory under idx- in the store.
##

include_guard(GLOBAL)

# __FetchLayer_variant_format(<out> <axis>=<value>…)
#   The variant with these values, written as one string; a pair not <axis>=<value>, or an axis given twice, is
#   an error
function(__FetchLayer_variant_format OUT)
    set(_triplet "")
    set(_pairs)
    set(_seen)
    foreach(_pair IN LISTS ARGN)
        if (NOT _pair MATCHES "^(${_FETCHLAYER_AXIS_NAME})=.+$")
            message(FATAL_ERROR "FetchLayer: not an <axis>=<value> pair: ${_pair}")
        endif()
        set(_axis "${CMAKE_MATCH_1}")
        if (_axis IN_LIST _seen)
            message(FATAL_ERROR "FetchLayer: the axis ${_axis} is given twice: ${ARGN}")
        endif()
        list(APPEND _seen "${_axis}")
        if (_pair MATCHES "^triplet=(.+)$")
            set(_triplet "${CMAKE_MATCH_1}")
        else()
            list(APPEND _pairs "${_pair}")
        endif()
    endforeach()
    list(SORT _pairs)
    set(_variant "${_triplet}")
    foreach(_pair IN LISTS _pairs)
        if (_variant)
            string(APPEND _variant "+")
        endif()
        string(APPEND _variant "${_pair}")
    endforeach()
    if (NOT _variant)
        set(_variant "any")
    endif()
    set(${OUT} "${_variant}" PARENT_SCOPE)
endfunction()

# __FetchLayer_variant_parse(<variant> <out>)
#   The <axis>=<value> pairs of the variant <variant>: the string variant_format wrote, taken apart
function(__FetchLayer_variant_parse VARIANT OUT)
    set(_pairs)
    if (NOT VARIANT STREQUAL "any")
        string(REPLACE "+" ";" _parts "${VARIANT}")
        foreach(_part IN LISTS _parts)
            if (_part MATCHES "=")
                list(APPEND _pairs "${_part}")
            else()
                list(APPEND _pairs "triplet=${_part}")
            endif()
        endforeach()
    endif()
    set(${OUT} "${_pairs}" PARENT_SCOPE)
endfunction()

# __FetchLayer_variant_extract(<variant> <axis> <out>)
#   The value of <axis> in the variant <variant>, empty when it has none
function(__FetchLayer_variant_extract VARIANT AXIS OUT)
    __FetchLayer_variant_parse("${VARIANT}" _pairs)
    set(_value "")
    foreach(_pair IN LISTS _pairs)
        if (_pair MATCHES "^${AXIS}=(.*)$")
            set(_value "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    set(${OUT} "${_value}" PARENT_SCOPE)
endfunction()

# __FetchLayer_variant_select(<staging> <variant> <out>)
#   The variant of <staging> that goes with <variant>: its own axes' values in it, the others dropped — a
#   dependency's variant. An axis of <staging> that <variant> lacks takes its native value
function(__FetchLayer_variant_select STAGING VARIANT OUT)
    __FetchLayer_staging_get("${STAGING}" AXES _axes)
    set(_pairs)
    foreach(_axis IN LISTS _axes)
        __FetchLayer_variant_extract("${VARIANT}" "${_axis}" _value)
        if (NOT _value)
            __FetchLayer_axis_get("${_axis}" NATIVE _value)
        endif()
        list(APPEND _pairs "${_axis}=${_value}")
    endforeach()
    __FetchLayer_variant_format(_variant ${_pairs})
    set(${OUT} "${_variant}" PARENT_SCOPE)
endfunction()

# __FetchLayer_variant_native(<variant> <out>)
#   TRUE when every axis of <variant> has its native value
function(__FetchLayer_variant_native VARIANT OUT)
    __FetchLayer_variant_parse("${VARIANT}" _pairs)
    set(_native TRUE)
    foreach(_pair IN LISTS _pairs)
        string(REGEX MATCH "^([^=]+)=(.*)$" _ "${_pair}")
        set(_axis "${CMAKE_MATCH_1}")
        set(_given "${CMAKE_MATCH_2}")
        __FetchLayer_axis_get("${_axis}" NATIVE _value)
        if (NOT _given STREQUAL _value)
            set(_native FALSE)
        endif()
    endforeach()
    set(${OUT} ${_native} PARENT_SCOPE)
endfunction()

# __FetchLayer_variant_list(<staging> <out>)
#   Every variant of <staging> to make available: each combination of its axes' VALUES
function(__FetchLayer_variant_list STAGING OUT)
    __FetchLayer_staging_get("${STAGING}" AXES _axes)
    set(_combinations "")          # each a list of pairs, joined by + for now
    set(_first TRUE)
    foreach(_axis IN LISTS _axes)
        __FetchLayer_axis_get("${_axis}" VALUES _values)
        set(_next)
        foreach(_value IN LISTS _values)
            if (_first)
                list(APPEND _next "${_axis}=${_value}")
            else()
                foreach(_combination IN LISTS _combinations)
                    list(APPEND _next "${_combination}+${_axis}=${_value}")
                endforeach()
            endif()
        endforeach()
        set(_combinations ${_next})
        set(_first FALSE)
    endforeach()
    set(_variants)
    if (_first)
        set(_variants any)
    else()
        foreach(_combination IN LISTS _combinations)
            string(REPLACE "+" ";" _pairs "${_combination}")
            __FetchLayer_variant_format(_variant ${_pairs})
            list(APPEND _variants "${_variant}")
        endforeach()
    endif()
    set(${OUT} "${_variants}" PARENT_SCOPE)
endfunction()
